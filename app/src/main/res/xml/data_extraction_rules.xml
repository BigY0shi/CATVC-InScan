<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and transfer rules for Android 12 and newer. The shop-system sign-in (device and session
     tokens) never leaves the phone: a new phone is set up with its own one-time setup code. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="shop_connection.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="shop_connection.xml" />
    </device-transfer>
</data-extraction-rules>
