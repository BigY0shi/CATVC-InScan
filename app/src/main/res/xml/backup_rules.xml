<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 11 and older. The shop-system sign-in (device and session tokens)
     must never leave the phone in a backup: a restored copy would let another phone act as this one. -->
<full-backup-content>
    <exclude domain="sharedpref" path="shop_connection.xml" />
</full-backup-content>
